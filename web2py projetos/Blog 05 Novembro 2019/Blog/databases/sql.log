    "name" CHAR(512),
    "table_name" CHAR(512),
    "record_id" INTEGER
);
success!
timestamp: 2019-10-14T15:27:01.340338
CREATE TABLE "auth_event"(
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
